<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="www\pet.html" CopyToOutputDirectory="PreserveNewest" LinkBase="www\" />
    <Content Include="www\pet-bundle.js" CopyToOutputDirectory="PreserveNewest" LinkBase="www\" />
    <Content Include="www\pixi.min.js" CopyToOutputDirectory="PreserveNewest" LinkBase="www\" />
    <Content Include="www\pixi-spine.js" CopyToOutputDirectory="PreserveNewest" LinkBase="www\" />
  </ItemGroup>

</Project>
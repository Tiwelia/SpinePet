<Window x:Class="SpinePet.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpinePet"
        Width="468"
        MinWidth="468"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#FE18181C"
        Foreground="#FFD1D5DB"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="OnWindowLoaded">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FE18181C" />
        <SolidColorBrush x:Key="SectionBrush" Color="#FF1E1F25" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FF3A3B41" />
        <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#FF5A5B62" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FFC084FC" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FFA1A6B0" />

        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FFD1D5DB" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFD1D5DB" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          HorizontalContentAlignment="Left"
                                          VerticalContentAlignment="Center"
                                          Padding="10,0,30,0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <ContentPresenter HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Margin="10,0,0,0" />
                                                <Path x:Name="Arrow"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"
                                                      Fill="#FFA1A6B0"
                                                      Data="M0,0 L4,4 L8,0 Z" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              IsHitTestVisible="False"
                                              Margin="10,0,30,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   StaysOpen="False">
                                <Grid>
                                    <Border Background="#FF2A2B32"
                                            BorderBrush="#FF5A5B62"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Margin="0,2,0,0">
                                        <ScrollViewer MaxHeight="220" SnapsToDevicePixels="True">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFD1D5DB" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF3A3B44" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF4A3B64" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFD1D5DB" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SectionBrush}" />
            <Setter Property="BorderBrush" Value="#FF34363E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="CharacterCardItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="#FF21232A"
                                BorderBrush="#FF34363E"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FFC084FC" />
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF282B35" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF262930" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="Opacity" Value="0" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBrush}" CornerRadius="16">
        <Grid Margin="18,18,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Character"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#FFE4E6EE" />
                <TextBlock x:Name="ModeLabel"
                           Text="Configuration Mode"
                           Margin="0,6,0,0"
                           FontSize="11"
                           Foreground="#FFB7BDD0" />
            </StackPanel>

            <ScrollViewer x:Name="MainScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <StackPanel>
                    <Border Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Characters"
                                       FontSize="12"
                                       Margin="0,0,0,8"
                                       Foreground="{StaticResource MutedBrush}" />

                            <ListBox x:Name="CharacterCards"
                                     ItemsSource="{Binding Characters}"
                                     SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}"
                                     SelectionChanged="OnCharacterSelectionChanged"
                                     PreviewMouseWheel="OnCharacterCardsPreviewMouseWheel"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource CharacterCardItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                     ScrollViewer.CanContentScroll="False"
                                     MinHeight="60"
                                     MaxHeight="520">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="186"
                                              Tag="{Binding}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0"
                                                    CornerRadius="4"
                                                    Background="#FF2C2F38"
                                                    BorderBrush="#FF3D414C"
                                                    BorderThickness="1"
                                                    ClipToBounds="True">
                                                <Grid Margin="6">
                                                    <Image Source="{Binding TexturePath}"
                                                           Stretch="Uniform" />
                                                </Grid>
                                            </Border>
                                            <Button Grid.Row="1"
                                                    Content="{Binding ShowHideLabel}"
                                                    IsEnabled="{Binding CanToggleVisibility}"
                                                    Height="28"
                                                    Margin="0,8,0,0"
                                                    Click="OnToggleCharacter"
                                                    Tag="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="Animation"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" />
                            <ComboBox x:Name="AnimationCombo"
                                      ItemsSource="{Binding SelectedAnimationNames}"
                                      SelectedItem="{Binding SelectedAnimation, Mode=TwoWay}"
                                      SelectionChanged="OnAnimationChanged"
                                      Margin="0,8,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="MoveSelectedCheckBox"
                                          Grid.Column="0"
                                          Margin="0"
                                          VerticalAlignment="Center"
                                          Content="Move Selected Nikke"
                                          Checked="OnMoveSelectionChanged"
                                          Unchecked="OnMoveSelectionChanged" />
                                <Button Grid.Column="1"
                                        Content="Reset Position"
                                        Height="28"
                                        Margin="8,0,0,0"
                                        Padding="10,0"
                                        VerticalAlignment="Center"
                                        Click="OnResetSelectedPosition"
                                        IsEnabled="{Binding HasSelectedCharacter}" />
                            </Grid>

                            <TextBlock Text="Scale Character"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="ScaleSlider"
                                        Grid.Column="0"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding SelectedScalePercent, Mode=TwoWay}"
                                        ValueChanged="OnScaleChanged"
                                        VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="R"
                                        Width="28"
                                        Height="20"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Padding="0"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="OnResetScale"
                                        ToolTip="Reset scale" />
                            </Grid>
                            <TextBlock Text="{Binding SelectedScaleDisplay}"
                                       Margin="0,4,0,14"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource MutedBrush}" />

                            <TextBlock Text="Animation Speed"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SpeedSlider"
                                        Grid.Column="0"
                                        Minimum="10"
                                        Maximum="200"
                                        Value="{Binding SelectedSpeed, Mode=TwoWay}"
                                        ValueChanged="OnSpeedChanged"
                                        VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="R"
                                        Width="28"
                                        Height="20"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Padding="0"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="OnResetSpeed"
                                        ToolTip="Reset speed" />
                            </Grid>
                            <TextBlock Text="{Binding SelectedSpeedDisplay}"
                                       Margin="0,4,0,14"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource MutedBrush}" />

                            <Button Content="Remove Character"
                                    Click="OnRemoveSelectedCharacter"
                                    IsEnabled="{Binding HasSelectedCharacter}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Tools"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FFE4E6EE"
                               Margin="0,0,0,10" />

                    <Border Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <Button Content="Add Character"
                                    Click="OnAddCharacter" />
                            <Button Content="Scan res Folder"
                                    Click="OnScanRes" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2"
                    Content="Exit Configuration"
                    Height="42"
                    Margin="0,12,0,0"
                    Click="OnExitConfiguration" />
        </Grid>
    </Border>
</Window>
